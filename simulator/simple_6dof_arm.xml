<mujoco model="simple_6dof_arm">
  <!--
    6-DOF serial arm + 2-finger parallel gripper (UR-style joint layout).
    Units: SI, angles in RADIANS (mjModel native; ctrl for position actuators is radians).

    Kinematic chain (joint axis in parentheses):
      base -> shoulder_pan (z) -> shoulder_lift (y) -> elbow (y)
           -> wrist1 (z, roll) -> wrist2 (y) -> wrist3 (z, roll) -> gripper
    Body names carry the joint they hold, so joint/actuator/body names line up.
  -->
  <compiler angle="radian" autolimits="true" inertiafromgeom="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" iterations="50"/>

  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.6 0.6 0.6"/>
  </visual>

  <default>
    <joint limited="true" damping="1.5" armature="0.01" frictionloss="0.05"/>
    <geom type="capsule" density="900" friction="1 0.005 0.0001" rgba="0.2 0.6 0.9 1"/>
    <default class="obstacle">
      <!-- Boxes parked 5 m under the floor (invisible, unreachable). RobotEnv.set_obstacles()
           moves them into the workspace via mocap_pos. -->
      <geom type="box" rgba="0.8 0.3 0.2 0" size="0.05 0.05 0.05"/>
    </default>
  </default>

  <worldbody>
    <light name="key" pos="1 -1 2.5" dir="-0.4 0.4 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.85 0.85 0.85 1"
          friction="1 0.005 0.0001"/>

    <!-- Visual-only goal marker (sites never collide). Moved by RobotEnv.reset(). -->
    <site name="target" pos="0.5 0 0.5" size="0.03" rgba="1 0.1 0.1 0.6"/>

    <camera name="track" pos="1.5 -1.3 1.1" mode="targetbody" target="forearm"/>

    <!-- Obstacle pool (index 0..5): mocap bodies so they can be moved at runtime
         (static world geoms are not re-collided after being edited). -->
    <body name="obstacle_0" mocap="true" pos="0 0 -5"><geom name="obstacle_0" class="obstacle"/></body>
    <body name="obstacle_1" mocap="true" pos="0 0 -5"><geom name="obstacle_1" class="obstacle"/></body>
    <body name="obstacle_2" mocap="true" pos="0 0 -5"><geom name="obstacle_2" class="obstacle"/></body>
    <body name="obstacle_3" mocap="true" pos="0 0 -5"><geom name="obstacle_3" class="obstacle"/></body>
    <body name="obstacle_4" mocap="true" pos="0 0 -5"><geom name="obstacle_4" class="obstacle"/></body>
    <body name="obstacle_5" mocap="true" pos="0 0 -5"><geom name="obstacle_5" class="obstacle"/></body>

    <!-- Fixed pedestal: spans z in [0, 0.12] (sits ON the floor, not through it) -->
    <body name="base" pos="0 0 0">
      <geom name="base_geom" type="cylinder" size="0.09 0.06" pos="0 0 0.06"
            rgba="0.4 0.4 0.4 1"/>

      <body name="shoulder" pos="0 0 0.12">
        <joint name="shoulder_pan" axis="0 0 1" range="-2.79 2.79"/>
        <geom name="shoulder_geom" type="cylinder" size="0.06 0.04" pos="0 0 0.04"
              rgba="0.3 0.5 0.8 1"/>

        <body name="upper_arm" pos="0 0 0.08">
          <joint name="shoulder_lift" axis="0 1 0" range="-2.09 2.09"/>
          <geom name="upper_arm_geom" fromto="0 0 0 0 0 0.30" size="0.045"/>

          <body name="forearm" pos="0 0 0.30">
            <joint name="elbow" axis="0 1 0" range="-2.09 2.09"/>
            <geom name="forearm_geom" fromto="0 0 0 0 0 0.25" size="0.04"/>

            <body name="wrist_1" pos="0 0 0.25">
              <joint name="wrist1" axis="0 0 1" range="-2.79 2.79"/>
              <geom name="wrist_1_geom" fromto="0 0 0 0 0 0.08" size="0.035"
                    rgba="0.3 0.7 0.95 1"/>

              <body name="wrist_2" pos="0 0 0.08">
                <joint name="wrist2" axis="0 1 0" range="-2.44 2.44"/>
                <geom name="wrist_2_geom" fromto="0 0 0 0 0 0.07" size="0.032"
                      rgba="0.3 0.7 0.95 1"/>

                <body name="wrist_3" pos="0 0 0.07">
                  <joint name="wrist3" axis="0 0 1" range="-1.75 1.75"/>
                  <geom name="palm_geom" type="box" size="0.03 0.05 0.03" pos="0 0 0.03"
                        rgba="0.25 0.25 0.25 1"/>

                  <!-- Fingers: q=0 closed, q=0.03 fully open. +y / -y slide outward. -->
                  <body name="left_finger" pos="0 0.012 0.06">
                    <joint name="left_finger_joint" type="slide" axis="0 1 0" range="0 0.03"
                           damping="3" armature="0.001" frictionloss="0"/>
                    <geom name="left_finger_geom" type="box" size="0.008 0.006 0.04" pos="0 0 0.04"
                          friction="1.5 0.005 0.0001" rgba="0.15 0.15 0.15 1"/>
                  </body>
                  <body name="right_finger" pos="0 -0.012 0.06">
                    <joint name="right_finger_joint" type="slide" axis="0 -1 0" range="0 0.03"
                           damping="3" armature="0.001" frictionloss="0"/>
                    <geom name="right_finger_geom" type="box" size="0.008 0.006 0.04" pos="0 0 0.04"
                          friction="1.5 0.005 0.0001" rgba="0.15 0.15 0.15 1"/>
                  </body>

                  <!-- End-effector tip: midpoint between the finger tips, ATTACHED to the arm -->
                  <site name="ee_tip" pos="0 0 0.14" size="0.012" rgba="0 1 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Position servos. ctrl = joint target in radians. forcerange = torque limit (N*m).
         kp/kv scaled to the inertia each joint sees (shoulder stiffest, wrist softest). -->
    <position name="shoulder_pan"  joint="shoulder_pan"  kp="200" kv="20" ctrlrange="-2.79 2.79" forcerange="-87 87"/>
    <position name="shoulder_lift" joint="shoulder_lift" kp="300" kv="30" ctrlrange="-2.09 2.09" forcerange="-87 87"/>
    <position name="elbow"         joint="elbow"         kp="250" kv="25" ctrlrange="-2.09 2.09" forcerange="-60 60"/>
    <position name="wrist1"        joint="wrist1"        kp="60"  kv="6"  ctrlrange="-2.79 2.79" forcerange="-28 28"/>
    <position name="wrist2"        joint="wrist2"        kp="60"  kv="6"  ctrlrange="-2.44 2.44" forcerange="-28 28"/>
    <position name="wrist3"        joint="wrist3"        kp="30"  kv="3"  ctrlrange="-1.75 1.75" forcerange="-28 28"/>

    <!-- Gripper: ctrl = opening (m), 0 closed .. 0.03 open -->
    <position name="left_finger_joint"  joint="left_finger_joint"  kp="400" kv="12" ctrlrange="0 0.03" forcerange="-25 25"/>
    <position name="right_finger_joint" joint="right_finger_joint" kp="400" kv="12" ctrlrange="0 0.03" forcerange="-25 25"/>
  </actuator>
</mujoco>
